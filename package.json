{
  "name": "modelwright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @modelwright/server --filter @modelwright/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "build:plugin": "pnpm --filter @modelwright/cli build:plugin",
    "format": "prettier --write .",
    "dev:desktop": "pnpm --filter @modelwright/desktop dev",
    "e2e:desktop": "pnpm --filter @modelwright/desktop e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
